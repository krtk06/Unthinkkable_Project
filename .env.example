MONGO_URI=mongodb+srv://cluster.example
MONGO_DATABASE=resume_screener
LOCAL_STORAGE_ROOT=.data/resumes
OBJECT_STORAGE_BUCKET=resume-files
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=text-embedding-3-small
# Leave EMPTY to reuse LLM_API_KEY for embeddings
EMBEDDING_API_KEY=
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_SOCKET=
MAX_FILE_BYTES=10485760
RETENTION_DAYS=30
LLM_TIMEOUT=30.0
AUTH_SECRET_KEY=
AUTH_TOKEN_EXPIRY_MINUTES=1440
SHORTLIST_THRESHOLD=7.0
